# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.env
.env.*
*.egg-info/
dist/
build/

# Model weights (large binaries — download with download_weights.py)
weights/*.pth
weights/*.pt
weights/*.h5
weights/*.keras
!weights/.gitkeep

# Uploads / temp files
uploads/
*.tmp

# IDE / OS
.vscode/
.idea/
*.DS_Store
Thumbs.db
desktop.ini

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Logs
*.log

# ─── ADDED: Strict Filters ───────────────────────────────────────

# Images (prevents committing test images or datasets)
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.bmp
*.tiff
*.svg
*.ico

# Videos
*.mp4
*.mkv
*.avi
*.mov
*.wmv
*.flv
*.webm
*.m4v

# Passwords, Secrets, and Keys
*.pem
*.key
*.cert
*.cer
*.crt
*.p12
*.pfx
*.secret
*.passwd
*.password
id_rsa
id_dsa
id_ed25519
id_ecdsa
credentials.json
client_secret.json
secrets.yml
*.keystore
